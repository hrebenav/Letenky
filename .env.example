# Zkopíruj do .env (soubor .env je v .gitignore, nikdy se necommitne).
# Na GitHubu tyhle hodnoty patří do Settings → Secrets and variables → Actions → Secrets.

# POVINNÉ – token z https://www.travelpayouts.com (Profil → API token)
TRAVELPAYOUTS_TOKEN=

# Volitelné – affiliate marker, propíše se do odkazů na Aviasales
TRAVELPAYOUTS_MARKER=

# Volitelné – e-mailová upozornění na cenovou bombu.
# Varianta A: Resend (doporučeno, jen HTTP, nic se neinstaluje)
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=Letenky <onboarding@resend.dev>

# Varianta B: vlastní SMTP (Gmail app password, Seznam…) – vyžaduje `npm install nodemailer`
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
